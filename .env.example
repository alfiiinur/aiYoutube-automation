# Prisma / PostgreSQL
# Contoh lokal (lihat docker-compose.yml):
DATABASE_URL="postgresql://studio:studio@localhost:5432/studio_yt?schema=public"

# Supabase / Neon / Railway (contoh):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&sslmode=require"

# Telegram bot (opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Pisahkan dengan koma kalau lebih dari satu chat
TELEGRAM_ALLOWED_CHAT_IDS=
# URL publik deployment (untuk webhook + link di pesan)
TELEGRAM_PUBLIC_URL=
# Disarankan: amankan webhook & endpoint cron
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
# Kunci penanda tangan cookie sesi (wajib di produksi, 32+ karakter acak)
SESSION_SECRET=

# Provider opsional — tanpa kunci ini aplikasi tetap jalan dalam mode simulasi
OPENAI_API_KEY=
# Meta Developer (1 app untuk Threads + Instagram + Facebook, lihat docs/meta-setup.md)
META_APP_ID=
META_APP_SECRET=
# Dipakai saat alur OAuth login Meta ditambahkan (boleh kosong untuk tempel-token manual)
META_REDIRECT_URI=
# Opsional: endpoint & model untuk AI planning goals (default OpenAI)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
RENDER_API_KEY=
ELEVENLABS_API_KEY=
